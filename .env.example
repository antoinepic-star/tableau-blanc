# Copie ce fichier en ".env" en local et remplis les valeurs (ne jamais committer le ".env" lui-même)
# Sur Render, renseigne ces mêmes variables dans le dashboard (Environment), pas dans ce fichier.

# Connexion au back-office (/admin) : identité centralisée, vérifiée auprès d'Administration.
# ADMINISTRATION_URL = URL de l'app Administration déployée.
# INTERNAL_API_SECRET = doit être IDENTIQUE à la valeur INTERNAL_API_SECRET d'Administration.
ADMINISTRATION_URL=
INTERNAL_API_SECRET=

JWT_SECRET=

# Si tu laisses TURSO_DATABASE_URL vide, l'app utilise un fichier SQLite local (data/whiteboard.db)
# -> parfait pour tester en local sans compte Turso.
# En prod sur Render, renseigne une vraie base Turso pour que les données survivent aux redéploiements.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

PORT=3000
